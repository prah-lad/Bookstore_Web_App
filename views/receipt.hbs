<!-- Book cover -->
<img src="/images/{{image}}" alt="{{title}} cover" width="250">

<br><br>

<!-- Thank you message -->
<p><strong>Thank you for your order of {{title}}!</strong></p>

<!-- Receipt table -->
<table border="1" cellpadding="8" cellspacing="0">
  <tr>
    <td><strong>Number of copies</strong></td>
    <td>{{copies}}</td>
  </tr>
  <tr>
    <td><strong>Price</strong></td>
    <td>${{price}}</td>
  </tr>
  <tr>
    <td><strong>Total (with tax)</strong></td>
    <td>${{total}}</td>
  </tr>
</table>

